---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import GeneralForm from '../components/forms/GeneralForm.astro';
import { routes, site } from '../lib/site';
---
<BaseLayout title={`Register interest | ${site.shortName}`} description={`Register interest in the ${site.name}.`}>
  <PageHero eyebrow="Register interest" title={`Register interest in ${site.shortName}.`}
    lede={`For prospective members, researchers, education providers, partners and others interested in ${site.shortName}'s development.`} />
  <section class="section"><div class="container">
    <GeneralForm />
    <p style="margin-top:48px" class="muted">Senior executive with enterprise AI accountability? <a class="text-link" href={routes.eoi}>Express interest in the Founding Council</a></p>
  </div></section>
</BaseLayout>
