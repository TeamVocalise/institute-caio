---
// Future-state member listing. SAMPLE DATA ONLY (src/content/directory.json).
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import { site } from '../lib/site';
const rows = (await getCollection('directory')).map((r) => r.data)
  .sort((a, b) => a.surname.localeCompare(b.surname, 'en-AU') || a.firstName.localeCompare(b.firstName, 'en-AU'));
const sectors = [...new Set(rows.map((r) => r.sector))].sort();
const memberships = [...new Set(rows.map((r) => r.membership.includes('Founding Council') ? 'Founding Council' : r.membership))];
const states = [...new Set(rows.map((r) => r.state))].sort();
---
<BaseLayout title={`Members | ${site.shortName}`} description={`Members of the ${site.name}.`}
  sampleNotice="ICAIO has not yet admitted members. Every name, role and organisation on this page is fictional placeholder content.">
  <PageHero eyebrow="Members" title="Member listing."
    lede={`Executives accountable for enterprise AI who are members of ${site.shortName}. Members appear here with their consent.`} />
  <section class="section"><div class="container">
    <div class="dir-tools" role="search" aria-label="Filter members">
      <div class="field"><label for="dir-q">Search</label><input id="dir-q" type="search" placeholder="Name, role or organisation" data-dir-search /></div>
      <div class="field"><label for="dir-sector">Sector</label>
        <select id="dir-sector" data-dir-filter="sector"><option value="">All sectors</option>{sectors.map((s) => <option>{s}</option>)}</select></div>
      <div class="field"><label for="dir-state">State or territory</label>
        <select id="dir-state" data-dir-filter="state"><option value="">All</option>{states.map((s) => <option>{s}</option>)}</select></div>
      <div class="field"><label for="dir-mem">Membership</label>
        <select id="dir-mem" data-dir-filter="membership"><option value="">All</option>{memberships.map((s) => <option>{s}</option>)}</select></div>
    </div>
    <p class="dir-count" aria-live="polite" data-dir-count>{rows.length} members</p>
    <div class="table-wrap">
      <table class="dir-table" data-dir-table>
        <caption class="sr-only">ICAIO members. Select a column heading to sort.</caption>
        <thead><tr>
          <th scope="col"><button type="button" data-sort="0" aria-sort="ascending">Name</button></th>
          <th scope="col"><button type="button" data-sort="1">Role</button></th>
          <th scope="col"><button type="button" data-sort="2">Organisation</button></th>
          <th scope="col"><button type="button" data-sort="3">Sector</button></th>
          <th scope="col"><button type="button" data-sort="4">State</button></th>
          <th scope="col"><button type="button" data-sort="5">Membership</button></th>
          <th scope="col" class="col-li"><span class="th-plain">LinkedIn</span></th>
        </tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr data-sector={r.sector} data-state={r.state} data-membership={r.membership.includes('Founding Council') ? 'Founding Council' : r.membership}>
              <td data-sort-value={`${r.surname} ${r.firstName}`}>{r.profile ? <a href={r.profile}>{r.firstName} {r.surname}</a> : <>{r.firstName} {r.surname}</>}</td>
              <td>{r.jobTitle}</td>
              <td>{r.organisation}</td>
              <td>{r.sector}</td>
              <td>{r.state}</td>
              <td>{r.membership}</td>
              <td class="col-li">{r.linkedin && (
                <a class="li-link" href={r.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${r.firstName} ${r.surname} on LinkedIn (opens in a new tab)`}>
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect width="24" height="24" rx="3" fill="currentColor"/><path fill="#fff" d="M7.1 9.5h2.5V17H7.1zM8.35 5.6a1.45 1.45 0 1 1 0 2.9 1.45 1.45 0 0 1 0-2.9zM11.2 9.5h2.4v1.03h.04c.33-.63 1.15-1.3 2.37-1.3 2.53 0 3 1.67 3 3.83V17h-2.5v-3.5c0-.84-.02-1.91-1.17-1.91-1.17 0-1.35.91-1.35 1.85V17h-2.5z"/></svg>
                </a>
              )}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted" style="margin-top:24px;font-size:.9rem">Membership categories, eligibility and listing preferences are still to be confirmed.</p>
  </div></section>
</BaseLayout>
