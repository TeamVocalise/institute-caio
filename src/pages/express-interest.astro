---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CouncilForm from '../components/forms/CouncilForm.astro';
import { routes, site } from '../lib/site';
---
<BaseLayout title={`Founding Council expression of interest | ${site.shortName}`} description={`Express interest in the ${site.shortName} Founding Council.`} current="/founding-council/">
  <PageHero eyebrow="Founding Council" title="Express interest in the Founding Council."
    lede="Help define the emerging profession of enterprise AI leadership in Australia. Tell us about your role and where you could contribute." />
  <section class="section"><div class="container">
    <CouncilForm />
    <p style="margin-top:48px" class="muted">Not applying for the Council? <a class="text-link" href={routes.register}>Register interest in {site.shortName}</a></p>
  </div></section>
</BaseLayout>
