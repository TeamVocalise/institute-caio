---
import type { CollectionEntry } from 'astro:content';
import Headshot from './Headshot.astro';
import Placeholder from '../ui/Placeholder.astro';
interface Props { member: CollectionEntry<'members'> }
const { member } = Astro.props;
const m = member.data;
const href = `/council/${member.id}/`;
---
<article class="member">
  <a class="headshot" href={href} tabindex="-1" aria-hidden="true"><Headshot src={m.headshot} /></a>
  <div class="member-body">
    <h3 class="member-name"><a href={href}>{m.firstName} <span class="surname">{m.surname}</span></a></h3>
    <p class="member-council">{m.councilTitle}</p>
    <p class="member-role">{m.jobTitle}<br /><span>{m.organisation}</span></p>
    <ul class="member-tags" aria-label="Expertise">{m.tags.map((t) => <li>{t}</li>)}</ul>
    <p class="member-statement">{m.statement}</p>
    <div class="member-links">
      <a class="text-link" href={href}>Full profile</a>
      {m.linkedin
        ? <a href={m.linkedin} class="member-ext" rel="noopener">LinkedIn</a>
        : <a href="#" class="member-ext" aria-disabled="true">LinkedIn <Placeholder>link</Placeholder></a>}
    </div>
  </div>
</article>
