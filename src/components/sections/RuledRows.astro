---
interface Props { items: { title: string; text?: string; tag?: string }[]; compact?: boolean }
const { items, compact = false } = Astro.props;
---
<ol class="rows">
  {items.map((it) => (
    <li>
      <h3 style={compact ? 'font-size:1.1rem' : undefined}>{it.title}{it.tag && <> <span class="tag">{it.tag}</span></>}</h3>
      <p>{it.text}</p>
    </li>
  ))}
</ol>
