---
import { getCollection } from 'astro:content';
interface Props { bandText: string; linkHref: string; linkLabel: string }
const { bandText, linkHref, linkLabel } = Astro.props;
const domains = (await getCollection('domains')).sort((a, b) => a.data.order - b.data.order);
---
<div class="domain-band"><p>{bandText}</p><a class="text-link" href={linkHref}>{linkLabel}</a></div>
<div class="domains">
  {domains.map((d) => (
    <article class="domain" id={`domain-${d.id}`}>
      <span class="domain-num">{String(d.data.order).padStart(2, '0')}</span>
      <h3>{d.data.name}</h3>
      <p>{d.data.audience && <strong>{d.data.audience}: </strong>}{d.data.description}</p>
    </article>
  ))}
</div>
