---
import Placeholder from '../ui/Placeholder.astro';
import { site, routes, footerExplore } from '../../lib/site';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <span class="brand-mark">{site.shortName}</span>
        <p>The {site.name} is being established as an independent, not-for-profit professional institution for executives accountable for enterprise AI.</p>
      </div>
      <div>
        <h2>Explore</h2>
        <ul>{footerExplore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div>
        <h2>Get involved</h2>
        <ul>
          <li><a href={routes.eoi}>Founding Council expression of interest</a></li>
          <li><a href={routes.register}>Register interest in {site.shortName}</a></li>
          <li><a href="/supporters/">Institute supporters</a></li>
        </ul>
      </div>
    </div>
    <p class="acknowledgement">{site.shortName} acknowledges the Traditional Custodians of the lands across Australia on which we live and work, and pays respect to Elders past and present. We recognise Aboriginal and Torres Strait Islander peoples' continuing connection to land, waters and culture.</p>
    <div class="footer-base">
      <span>{site.domain} &middot; Draft for review, October 2026</span>
      <span class="footer-legal"><a href="/privacy/">Privacy policy</a><a href="/terms/">Terms of use</a><span>Operating entity: <Placeholder>Responsible entity and ABN</Placeholder></span></span>
    </div>
  </div>
</footer>
